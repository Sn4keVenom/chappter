# ─────────────────────────────────────────────────────────────────────────────
# ChapterHub Mobile — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Found in Clerk Dashboard → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Your machine's LAN IP address — NOT localhost (won't work on a physical
# device connected over Expo Go). Find it via System Settings → Network
# (macOS) or `ipconfig` (Windows).
EXPO_PUBLIC_API_URL="http://192.168.1.x:4000/api/v1"
