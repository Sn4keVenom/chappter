{
  "name": "chapterhub",
  "version": "1.0.0",
  "private": true,
  "description": "Theta Tau chapter operations platform — mobile app",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "backend": "npm --prefix backend run dev",
    "backend:seed": "npm --prefix backend run db:seed",
    "backend:migrate": "npm --prefix backend run db:migrate:dev"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^1.3.0",
    "@react-native-community/datetimepicker": "^7.7.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.7.2",
    "expo": "~51.0.17",
    "expo-camera": "~15.0.14",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.2",
    "react-native-gesture-handler": "~2.16.2",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "~0.73.0",
    "typescript": "^5.4.5"
  }
}
