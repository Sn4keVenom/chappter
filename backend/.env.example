# ─────────────────────────────────────────────────────────────────────────────
# Chappter Backend — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For local dev use docker-compose (see README).
DATABASE_URL="postgresql://chappter:changeme@localhost:5432/chappter_dev"

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Found in Clerk Dashboard → API Keys
CLERK_SECRET_KEY="sk_test_..."

# Webhook signing secret — Clerk Dashboard → Webhooks → your endpoint → Signing
# Secret. Point the endpoint at POST /api/v1/webhooks/clerk and subscribe to
# at least "user.deleted" (see backend/routes/webhook.routes.ts).
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# ── Stripe ────────────────────────────────────────────────────────────────────
# Secret key — Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."

# Webhook signing secret — Stripe Dashboard → Developers → Webhooks → your endpoint
# For local testing: `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of allowed CORS origins — the web app's origin. Vite
# serves on 5173 in development; in production this must list the deployed
# site's origin (the server refuses to start without it in production).
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"
