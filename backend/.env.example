# ─────────────────────────────────────────────────────────────────────────────
# ChapterHub Backend — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For local dev use docker-compose (see README).
DATABASE_URL="postgresql://chapterhub:changeme@localhost:5432/chapterhub_dev"

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Found in Clerk Dashboard → API Keys
CLERK_SECRET_KEY="sk_test_..."

# ── Stripe ────────────────────────────────────────────────────────────────────
# Secret key — Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."

# Webhook signing secret — Stripe Dashboard → Developers → Webhooks → your endpoint
# For local testing: `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of allowed CORS origins.
# Set to the Expo dev server URL in development; your production domain in prod.
CORS_ORIGIN="http://localhost:8081,exp://localhost:8081"

NODE_ENV="development"
