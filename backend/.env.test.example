# Template for backend/.env.test (gitignored — copy this and fill in your
# own local Postgres user). Loaded by tests/setup.ts for `npm test`.
#
# No real secrets belong here — CLERK_SECRET_KEY/CLERK_WEBHOOK_SIGNING_SECRET
# are dummy values because @clerk/backend's verifyToken/verifyWebhook are
# mocked in tests (see tests/setup.ts) rather than hitting Clerk's network.
#
# Setup:
#   createdb chapterhub_test
#   cp .env.test.example .env.test   # then fill in DATABASE_URL below
#   DATABASE_URL="<value below>" npx prisma migrate deploy
#   npm test
NODE_ENV="test"
DATABASE_URL="postgresql://YOUR_OS_USERNAME@localhost:5432/chapterhub_test"
CLERK_SECRET_KEY="sk_test_dummy_for_tests"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_dummy_for_tests"
