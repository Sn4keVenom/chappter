// Chappter — Prisma schema
// Postgres. Run `npx prisma migrate dev --name init` after copying into a project.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

// Permission tier. The OFFICER tier was removed — committee chairs are
// tracked via CommitteeMembership.role = CHAIR (already existed,
// independent of this enum), not a separate role value. See
// middleware/rbac.ts requireCommitteeScope for the scoped chair check, and
// the mobile app's src/permissions/permissions.ts for the full granular
// permission system this enum feeds into (roles are just presets there).
enum UserRole {
  SUPER_ADMIN
  EXEC
  MEMBER
  PNM
  ALUMNI
}

// Membership lifecycle status — independent of UserRole (see
// ChapterMembership's role/office fields below). PNM/ALUMNI status usually
// correlates with the same-named role, but isn't derived from it.
enum MemberStatus {
  ACTIVE
  PNM
  ALUMNI
  INACTIVE
}

// Named exec-board position. Independent from UserRole/permissions by
// design — assigning a new office never changes what a user can do; only
// role + the RolePermission table does. New offices can be added here
// without touching the permission system.
enum ExecOffice {
  REGENT
  VICE_REGENT
  TREASURER
  SCRIBE
  MARSHAL
  CORRESPONDING_SECRETARY
  NEW_MEMBER_EDUCATOR
}

enum ModuleKey {
  EVENTS
  ATTENDANCE
  MESSAGING
  DOCUMENTS
  POINTS
  CALENDAR
  FEEDBACK
  COMMITTEES
  DUES
  TEAMS
  OFFICE_INVENTORY
  ATTENDANCE_RAFFLES
}

enum DocumentCategory {
  CONSTITUTION
  BYLAWS
  MEETING_MINUTES
  RECRUITMENT
  FORMS
  OFFICER_RESOURCES
  OTHER
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum EventCategory {
  BROTHERHOOD
  SERVICE
  PROFESSIONAL
  RUSH
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum CheckInMethod {
  QR
  MANUAL
}

enum LedgerType {
  ATTENDANCE
  BONUS
  PENALTY
  MANUAL_ADJUSTMENT
}

enum CommitteeRole {
  MEMBER
  CHAIR
}

enum ChannelType {
  GENERAL
  COMMITTEE
  OFFICERS
  DM
}

enum ChannelMemberRole {
  MEMBER
  ADMIN
}

enum DuesStatus {
  PAID
  PARTIAL
  UNPAID
  WAIVED
}

enum PaymentMethod {
  STRIPE
  PYLI
  CASH
  VENMO
  CHECK
  OTHER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// ─────────────────────────────────────────────────────────────────────────
// Core identity
//
// User is identity only — auth + personal-profile facts that exist
// independent of any chapter. Membership facts (role, office, status, role
// number, pledge class, major, graduation year, Big/Little) live on
// ChapterMembership instead, because they're properties of "this person's
// membership in this chapter," not of the person globally. This is what
// lets role numbers be unique per-chapter, Big/Little resolve within one
// chapter's roster, and a person hold (now or later) more than one chapter
// membership without any of those concepts colliding. See ChapterMembership
// below and docs/PERMISSIONS.md for how role/office/status continue to
// drive permissions from there.
// ─────────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  authProviderId String   @unique // Clerk/Firebase UID
  email          String   @unique
  username       String   @unique
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  // Which chapter's membership currently drives this user's flattened
  // role/office/status in API responses. Null until they join their first
  // chapter (see auth.routes.ts /auth/sync and chapters.routes.ts redeem/
  // approve flows, which set this the first time it's unset). A user
  // belonging to more than one chapter is already representable via
  // chapterMemberships below — switching activeChapterId between them is
  // future UI, not required now.
  activeChapterId String?
  // Set by the Clerk `user.deleted` webhook (webhook.routes.ts) — never by
  // application code directly. Soft delete, not a hard row delete: a hard
  // delete would cascade through ChapterMembership (bigMembershipId
  // SetNull is fine, but AuditLog/Attendance/Message/etc. FKs are NOT all
  // cascade-safe for a record chapters rely on for history) and would also
  // free the unique authProviderId/email/username for reuse in a way that
  // could collide with a re-signup. authMiddleware treats a non-null
  // deletedAt as "not authenticated" (401), same as if the row didn't
  // exist. email/username are also rewritten to a deleted-* placeholder at
  // the same time so the original values become available again — see
  // webhook.routes.ts.
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activeChapter        Chapter?              @relation("UserActiveChapter", fields: [activeChapterId], references: [id])
  chapterMemberships   ChapterMembership[]
  inviteRedemptions    ChapterInviteRedemption[]
  joinRequests         ChapterJoinRequest[]
  claimedRosterEntry   ChapterRosterEntry?
  committeeMemberships CommitteeMembership[]
  rsvps                Rsvp[]
  attendances          Attendance[]          @relation("AttendanceUser")
  recordedAttendances  Attendance[]          @relation("AttendanceRecordedBy")
  pointsLedgerEntries  PointsLedger[]        @relation("LedgerOwner")
  awardedLedgerEntries PointsLedger[]        @relation("LedgerAwardedBy")
  duesRecords          DuesRecord[]
  recordedPayments     Payment[]             @relation("PaymentRecordedBy")
  channelMemberships   ChannelMembership[]
  messages             Message[]
  createdEvents        Event[]               @relation("EventCreatedBy")
  auditLogs            AuditLog[]            @relation("AuditActor")
  uploadedDocuments    Document[]            @relation("DocumentUploadedBy")
  feedbackReports      FeedbackReport[]      @relation("FeedbackSubmittedBy")

  @@index([activeChapterId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Chapter & Membership
//
// A Chapter is a tenant. ChapterMembership is the join row that carries
// everything that's actually "about this person's time in this chapter":
// role/office/status (permission-relevant — see docs/PERMISSIONS.md),
// roleNumber (permanent, assigned post-initiation, unique per chapter),
// Big/Little (self-relation scoped to the same chapter's memberships so
// family trees never cross chapters), and the historical fields (initiation/
// graduation dates) called for in spec §10 — nullable today so they can be
// filled in gradually without another migration.
//
// Status changes (ACTIVE → ALUMNI/INACTIVE) only ever update this row's
// `status` column — they never touch bigMembershipId/littles, so family
// relationships keep working after someone graduates or goes inactive.
// ─────────────────────────────────────────────────────────────────────────

model Chapter {
  id         String   @id @default(cuid())
  name       String
  letters    String?
  university String?
  logoUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  settings        ChapterSettings?
  memberships     ChapterMembership[]
  invites         ChapterInvite[]
  joinRequests    ChapterJoinRequest[]
  rosterEntries   ChapterRosterEntry[]
  teams           Team[]
  // Users whose activeChapterId currently points here — not "all members"
  // (that's memberships above), just whichever users have this chapter
  // selected as their current context.
  usersActiveHere User[]              @relation("UserActiveChapter")

  @@index([name])
}

model ChapterMembership {
  id               String       @id @default(cuid())
  userId           String
  chapterId        String
  role             UserRole     @default(MEMBER)
  office           ExecOffice?  // Exec-board position, independent of role/permissions — see ExecOffice doc comment
  status           MemberStatus @default(PNM)
  // Assigned after initiation only — enforced in membership.routes.ts, not
  // just by convention. Unique per chapter; Postgres treats multiple NULLs
  // (every PNM) as distinct, so PNMs never collide with each other or block
  // a real assignment.
  roleNumber       Int?
  pledgeClassLabel String?      // e.g. "Fall 2024" — free text by design, cosmetic only
  major            String?
  graduationYear   Int?
  initiationDate   DateTime?
  graduationDate   DateTime?
  // This membership's Big — a self-relation so Big/Little always resolves
  // within the same chapter's roster. onDelete: SetNull because membership
  // rows are never deleted in normal operation (status handles lifecycle);
  // this only guards against an intentional admin data-wipe corrupting the
  // rest of a family line.
  bigMembershipId  String?
  // Provenance: which membership invited (via invite code) or approved
  // (via join request) this one — optional, not enforced, just historical.
  invitedById      String?
  // Gamification team (see Team model below) — NOT a committee: no chair,
  // and a member belongs to at most one (reassigning replaces it, it doesn't
  // add a second). Chapter-scoped like role/office/status/major above,
  // rather than living on User, for the same reason all of those moved here.
  teamId           String?
  joinedAt         DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter        Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  big            ChapterMembership?  @relation("BigLittle", fields: [bigMembershipId], references: [id], onDelete: SetNull)
  littles        ChapterMembership[] @relation("BigLittle")
  invitedBy      ChapterMembership?  @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedMembers ChapterMembership[] @relation("MembershipInvitedBy")
  createdInvites ChapterInvite[]
  reviewedJoinRequests ChapterJoinRequest[]
  createdRosterEntries ChapterRosterEntry[]
  team           Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([chapterId, userId])
  @@unique([chapterId, roleNumber])
  @@index([chapterId, role])
  @@index([chapterId, status])
  @@index([bigMembershipId])
  @@index([teamId])
}

// Gamification teams (Feature 2 — src/types/index.ts Team doc comment).
// Deliberately NOT a committee: no chair/role distinction, and membership is
// exclusive (a ChapterMembership.teamId points at one Team or none — see
// that field's doc comment) where CommitteeMembership is many-to-many.
// Points aren't stored here; a team's total is computed by summing
// PointsLedger for its current members, same as the individual leaderboard
// at GET /points/leaderboard (backend/routes/attendance.routes.ts) — see
// GET /teams/leaderboard in backend/routes/teams.routes.ts.
model Team {
  id        String   @id @default(cuid())
  chapterId String
  name      String
  color     String? // hex, e.g. "#5B6CC0" — optional, purely cosmetic
  createdAt DateTime @default(now())

  chapter Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  members ChapterMembership[]

  @@unique([chapterId, name])
  @@index([chapterId])
}

// One row per invite code. A "link" is just this same code embedded in a
// deep link (chappter://join?code=XXXX) — no separate model needed for
// "code" vs. "link", they're two presentations of the same redeemable thing.
model ChapterInvite {
  id          String       @id @default(cuid())
  chapterId   String
  code        String       @unique
  role        UserRole     @default(MEMBER)
  status      MemberStatus @default(PNM) // status a redeemer starts as
  maxUses     Int?         // null = unlimited
  useCount    Int          @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime     @default(now())

  chapter     Chapter                   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdBy   ChapterMembership         @relation(fields: [createdById], references: [id])
  redemptions ChapterInviteRedemption[]

  @@index([chapterId])
}

model ChapterInviteRedemption {
  id         String   @id @default(cuid())
  inviteId   String
  userId     String
  redeemedAt DateTime @default(now())

  invite ChapterInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
}

// A user may accumulate multiple APPROVED/DENIED rows over time (request,
// get denied, request again later) — only PENDING must be unique per
// (chapterId, userId). Prisma's schema DSL has no way to declare a
// filtered/partial unique index, so this constraint exists ONLY in the
// migration SQL (see migrations/20260710_join_request_partial_unique) as a
// `CREATE UNIQUE INDEX ... WHERE status = 'PENDING'` — it is real in the
// database even though it can't be written here. Do not let a future
// `prisma migrate dev` diff drop it by surprise; the app-level pre-check in
// chapters.routes.ts is a fast-path UX nicety, this index is the actual
// guarantee (see the P2002 handling there for the race it closes).
model ChapterJoinRequest {
  id           String            @id @default(cuid())
  chapterId    String
  userId       String
  message      String?
  status       JoinRequestStatus @default(PENDING)
  // Set only when this request was auto-filed by POST /chapters/claim-role-number
  // (roster-verified signup) — derived server-side from the matched
  // ChapterRosterEntry, never from client input. Null for ordinary
  // browse-chapter/invite-adjacent requests. On approval, chapters.routes.ts
  // seeds ChapterMembership.role/status/roleNumber from these instead of
  // leaving them at schema defaults. Named memberStatus (not `status`) to
  // avoid colliding with this model's own request-lifecycle status above.
  roleNumber   Int?
  memberStatus MemberStatus?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  chapter    Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy ChapterMembership? @relation(fields: [reviewedById], references: [id])

  @@index([chapterId, status])
  @@index([userId])
}

// Exec-maintained verification list, independent of who has actually signed
// up (see ChapterMembership.roleNumber, which is only assigned to real
// members after they already have an account — this is the opposite
// direction: real member identity data, pre-loaded, that a new signup's
// claimed name + role number gets checked against). claimedByUserId is set
// atomically by POST /chapters/claim-role-number the first time a signup
// successfully matches this row, so two people can never both claim role
// #214. lastName is stored for exec's own bookkeeping in the admin list
// only — matching is first-name-only by design (see doc comment on the
// verify-role-number route), so it is never used in the lookup query.
model ChapterRosterEntry {
  id              String       @id @default(cuid())
  chapterId       String
  firstName       String
  lastName        String
  roleNumber      Int
  status          MemberStatus // ACTIVE | ALUMNI only — PNMs never have a role number
  claimedByUserId String?      @unique
  createdById     String
  createdAt       DateTime     @default(now())

  chapter   Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  claimedBy User?             @relation(fields: [claimedByUserId], references: [id])
  createdBy ChapterMembership @relation(fields: [createdById], references: [id])

  @@unique([chapterId, roleNumber])
  @@index([chapterId, firstName])
}

model Semester {
  id        String   @id @default(cuid())
  label     String   @unique // "Fall 2026"
  startDate DateTime
  endDate   DateTime

  duesRecords   DuesRecord[]
  ledgerEntries PointsLedger[]

  @@index([startDate, endDate])
}

// ─────────────────────────────────────────────────────────────────────────
// Committees
// ─────────────────────────────────────────────────────────────────────────

model Committee {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CommitteeMembership[]
  events      Event[]
  channel     Channel?

  @@index([name])
}

model CommitteeMembership {
  id          String        @id @default(cuid())
  committeeId String
  userId      String
  role        CommitteeRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([committeeId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Events, RSVPs, Attendance
// ─────────────────────────────────────────────────────────────────────────

model Event {
  id                  String        @id @default(cuid())
  title               String
  description         String?
  location            String?
  latitude            Float?
  longitude           Float?
  startTime           DateTime
  endTime             DateTime
  category            EventCategory
  status              EventStatus   @default(DRAFT)
  attendanceRequired  Boolean       @default(false)
  pointValue          Int           @default(0)
  checkInWindowStart  DateTime?
  checkInWindowEnd    DateTime?
  lateThresholdMinutes Int          @default(15)
  checkInTokenSecret  String        // rotating QR signing secret, not exposed directly to clients
  committeeId         String?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  committee   Committee?   @relation(fields: [committeeId], references: [id])
  createdBy   User         @relation("EventCreatedBy", fields: [createdById], references: [id])
  rsvps       Rsvp[]
  attendances Attendance[]
  ledgerEntries PointsLedger[]

  @@index([startTime])
  @@index([category])
  @@index([committeeId])
  // Every list endpoint filters status="PUBLISHED" first, then a startTime
  // range — this compound index serves that combined filter directly
  // instead of Postgres falling back to the single-column startTime index
  // and re-checking status per row.
  @@index([status, startTime])
}

model Rsvp {
  id          String     @id @default(cuid())
  eventId     String
  userId      String
  status      RsvpStatus
  respondedAt DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

model Attendance {
  id              String        @id @default(cuid())
  eventId         String
  userId          String
  checkInTime     DateTime      @default(now())
  method          CheckInMethod
  late            Boolean       @default(false)
  pointsAwarded   Int           // snapshot — independent of later Event.pointValue edits
  recordedById    String?       // set when an officer manually marks attendance
  overrideReason  String?
  createdAt       DateTime      @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User  @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Points (append-only ledger)
// ─────────────────────────────────────────────────────────────────────────

model PointsLedger {
  id           String     @id @default(cuid())
  userId       String
  eventId      String?
  semesterId   String
  amount       Int        // can be negative for PENALTY/adjustment
  type         LedgerType
  reason       String?
  awardedById  String?    // null for system-generated ATTENDANCE entries
  createdAt    DateTime   @default(now())

  user      User      @relation("LedgerOwner", fields: [userId], references: [id], onDelete: Cascade)
  event     Event?    @relation(fields: [eventId], references: [id])
  semester  Semester  @relation(fields: [semesterId], references: [id])
  awardedBy User?     @relation("LedgerAwardedBy", fields: [awardedById], references: [id])

  @@index([userId, semesterId])
  @@index([semesterId])
}

// ─────────────────────────────────────────────────────────────────────────
// Dues & Payments
// ─────────────────────────────────────────────────────────────────────────

model DuesRecord {
  id          String     @id @default(cuid())
  userId      String
  semesterId  String
  amountOwed  Decimal    @db.Decimal(10, 2)
  amountPaid  Decimal    @default(0) @db.Decimal(10, 2)
  status      DuesStatus @default(UNPAID)
  dueDate     DateTime?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester Semester  @relation(fields: [semesterId], references: [id])
  payments Payment[]

  @@unique([userId, semesterId])
  @@index([status])
  @@index([semesterId])
}

// externalRef (Stripe payment intent id) must be unique among non-null
// values, so two concurrent deliveries of the same webhook event can't both
// create a Payment row — but manual/cash payments (externalRef = NULL) must
// NOT be deduplicated against each other. Prisma's schema DSL has no way to
// declare a filtered/partial unique index, so this constraint exists ONLY
// in the migration SQL (see migrations/20260710092000_payment_external_ref_
// partial_unique) as a `CREATE UNIQUE INDEX ... WHERE "externalRef" IS NOT
// NULL` — it is real in the database even though it can't be written here.
// Do not let a future `prisma migrate dev` diff drop it by surprise; the
// app-level pre-check in webhook.routes.ts is a fast-path nicety, this
// index is the actual guarantee (see the P2002 handling there).
model Payment {
  id            String        @id @default(cuid())
  duesRecordId  String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  externalRef   String?       // Stripe payment intent id, etc.
  recordedById  String?       // null for webhook-originated payments
  paidAt        DateTime      @default(now())

  duesRecord DuesRecord @relation(fields: [duesRecordId], references: [id], onDelete: Cascade)
  recordedBy User?      @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([duesRecordId])
}

// ─────────────────────────────────────────────────────────────────────────
// Messaging
// ─────────────────────────────────────────────────────────────────────────

model Channel {
  id          String      @id @default(cuid())
  name        String
  type        ChannelType
  committeeId String?     @unique // set only for COMMITTEE-type channels
  createdAt   DateTime    @default(now())
  // Archived channels drop out of the channel list and reject new messages,
  // but keep every message they already hold — chapters refer back to old
  // discussions, so this is never a delete. Nullable-timestamp rather than a
  // boolean so "when was this retired" is answerable later.
  archivedAt  DateTime?

  committee Committee?          @relation(fields: [committeeId], references: [id])
  members   ChannelMembership[]
  messages  Message[]

  @@index([type])
}

model ChannelMembership {
  id        String            @id @default(cuid())
  channelId String
  userId    String
  role      ChannelMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id              String    @id @default(cuid())
  channelId       String
  senderId        String
  content         String
  parentMessageId String?
  pinned          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  channel Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User      @relation(fields: [senderId], references: [id])
  parent  Message?  @relation("Thread", fields: [parentMessageId], references: [id])
  replies Message[] @relation("Thread")

  @@index([channelId, createdAt])
  @@index([channelId, deletedAt, createdAt])  // last-message-per-channel query: filters deletedAt=null then sorts createdAt desc
  @@index([parentMessageId])
}

// ─────────────────────────────────────────────────────────────────────────
// Audit trail
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // e.g. "EVENT_UPDATE", "ATTENDANCE_OVERRIDE", "ROLE_CHANGE"
  entityType String   // e.g. "Event", "Attendance", "DuesRecord"
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Permission system — "roles should simply be permission presets."
// One row per (role, permission) grant. Permission is a free-text string
// (not an enum) so a new permission can be introduced by the application
// layer without a migration — matches src/types/index.ts ALL_PERMISSIONS
// on the mobile side, which is the source of truth for valid values.
// SUPER_ADMIN intentionally has no rows here — it always bypasses (see
// mobile src/permissions/permissions.ts hasPermission()); this mirrors that
// in the schema by simply never being queried for that role.
// ─────────────────────────────────────────────────────────────────────────

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  // No separate @@index([role]) — the unique constraint below already
  // leads with `role`, so it serves role-only lookups too; a second index
  // on the same leading column would be pure write-overhead with no read
  // benefit.
  @@unique([role, permission])
}

// Parallel to RolePermission, for grants scoped to a named exec office
// rather than a role tier — e.g. "Scribe can assign role numbers" even
// though MEMBER-tier role presets don't grant it. Checked as an additional
// OR alongside RolePermission, never a replacement for it (see
// requirePermission in middleware/rbac.ts).
model OfficePermission {
  id         String     @id @default(cuid())
  office     ExecOffice
  permission String
  createdAt  DateTime   @default(now())

  @@unique([office, permission])
}

// ─────────────────────────────────────────────────────────────────────────
// Module / feature toggles
// ─────────────────────────────────────────────────────────────────────────

model Module {
  key         ModuleKey @id
  label       String
  description String?
  enabled     Boolean   @default(true)
  comingSoon  Boolean   @default(false)
}

// ─────────────────────────────────────────────────────────────────────────
// Chapter Settings — one row per Chapter (chapterId is unique, so it's a
// 1:1 with Chapter, not a free-standing singleton).
//
// This used to be a hardcoded `id: "default"` singleton because there was
// no Chapter model at all. Identity/roster/family/role-number/invite data
// is now genuinely multi-chapter-capable (see Chapter/ChapterMembership
// above) — this settings row just carries the per-chapter operational
// defaults (semester label/dates, dues defaults, attendance thresholds).
// Chapter's own name/letters/university live on Chapter itself now, not
// duplicated here.
//
// Note: Event/Committee/DuesRecord/Message/etc. are still NOT chapterId-
// scoped — that remains a deliberately separate, larger migration (see the
// account-system implementation plan for the explicit scope line). This
// settings row only being per-chapter doesn't by itself make those other
// tables multi-tenant.
// ─────────────────────────────────────────────────────────────────────────

model ChapterSettings {
  id                              String   @id @default(cuid())
  chapterId                       String   @unique
  currentSemesterLabel            String
  semesterStartDate               DateTime
  semesterEndDate                 DateTime
  defaultDuesAmount               Decimal  @db.Decimal(10, 2)
  defaultDuesPlan                 String   @default("FULL")
  attendanceLateThresholdMinutes  Int      @default(15)
  defaultEventPointValue          Int      @default(5)
  updatedAt                       DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// Documents & external links
// ─────────────────────────────────────────────────────────────────────────

model Document {
  id           String           @id @default(cuid())
  category     DocumentCategory
  name         String
  fileLabel    String           // placeholder filename — no real object storage yet, see docs/DEMO_MODE.md
  sizeLabel    String?
  uploadedById String
  uploadedAt   DateTime         @default(now())

  uploadedBy User @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([category])
}

model ExternalLink {
  id       String  @id @default(cuid())
  label    String
  url      String
  category String?
}

// ─────────────────────────────────────────────────────────────────────────
// Feedback & bug reports
// ─────────────────────────────────────────────────────────────────────────

model FeedbackReport {
  id             String         @id @default(cuid())
  type           FeedbackType
  message        String
  submittedById  String?
  appVersion     String
  platform       String
  status         FeedbackStatus @default(OPEN)
  createdAt      DateTime       @default(now())

  submittedBy User? @relation("FeedbackSubmittedBy", fields: [submittedById], references: [id])

  @@index([status])
  @@index([type])
}
