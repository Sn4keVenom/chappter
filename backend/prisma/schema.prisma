// ChapterHub — Prisma schema
// Postgres. Run `npx prisma migrate dev --name init` after copying into a project.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

// Permission tier. The OFFICER tier was removed — committee chairs are
// tracked via CommitteeMembership.role = CHAIR (already existed,
// independent of this enum), not a separate role value. See
// middleware/rbac.ts requireCommitteeScope for the scoped chair check, and
// the mobile app's src/permissions/permissions.ts for the full granular
// permission system this enum feeds into (roles are just presets there).
enum UserRole {
  SUPER_ADMIN
  EXEC
  MEMBER
  PNM
  ALUMNI
}

// Membership lifecycle status — independent of UserRole (see User.role/
// User.office doc comments below). PNM/ALUMNI status usually correlates
// with the same-named role, but isn't derived from it.
enum MemberStatus {
  ACTIVE
  PNM
  ALUMNI
  INACTIVE
}

// Named exec-board position. Independent from UserRole/permissions by
// design — assigning a new office never changes what a user can do; only
// role + the RolePermission table does. New offices can be added here
// without touching the permission system.
enum ExecOffice {
  REGENT
  VICE_REGENT
  TREASURER
  SCRIBE
  MARSHAL
  CORRESPONDING_SECRETARY
  NEW_MEMBER_EDUCATOR
}

enum ModuleKey {
  EVENTS
  ATTENDANCE
  MESSAGING
  DOCUMENTS
  POINTS
  CALENDAR
  FEEDBACK
  COMMITTEES
  DUES
  TEAMS
  OFFICE_INVENTORY
  ATTENDANCE_RAFFLES
}

enum DocumentCategory {
  CONSTITUTION
  BYLAWS
  MEETING_MINUTES
  RECRUITMENT
  FORMS
  OFFICER_RESOURCES
  OTHER
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum EventCategory {
  BROTHERHOOD
  SERVICE
  PROFESSIONAL
  RUSH
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum CheckInMethod {
  QR
  MANUAL
}

enum LedgerType {
  ATTENDANCE
  BONUS
  PENALTY
  MANUAL_ADJUSTMENT
}

enum CommitteeRole {
  MEMBER
  CHAIR
}

enum ChannelType {
  GENERAL
  COMMITTEE
  OFFICERS
  DM
}

enum ChannelMemberRole {
  MEMBER
  ADMIN
}

enum DuesStatus {
  PAID
  PARTIAL
  UNPAID
  WAIVED
}

enum PaymentMethod {
  STRIPE
  PYLI
  CASH
  VENMO
  CHECK
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────
// Core identity
// ─────────────────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  authProviderId String       @unique // Clerk/Firebase UID
  email         String        @unique
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  role          UserRole      @default(MEMBER)
  office        ExecOffice?   // Exec-board position, independent of role/permissions — see ExecOffice doc comment
  status        MemberStatus  @default(ACTIVE)
  pledgeClassLabel String?    // e.g. "Fall 2024" — free text by design, cosmetic only
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  committeeMemberships CommitteeMembership[]
  rsvps                Rsvp[]
  attendances          Attendance[]          @relation("AttendanceUser")
  recordedAttendances  Attendance[]          @relation("AttendanceRecordedBy")
  pointsLedgerEntries  PointsLedger[]        @relation("LedgerOwner")
  awardedLedgerEntries PointsLedger[]        @relation("LedgerAwardedBy")
  duesRecords          DuesRecord[]
  recordedPayments     Payment[]             @relation("PaymentRecordedBy")
  channelMemberships   ChannelMembership[]
  messages             Message[]
  createdEvents        Event[]               @relation("EventCreatedBy")
  auditLogs            AuditLog[]            @relation("AuditActor")
  uploadedDocuments    Document[]            @relation("DocumentUploadedBy")
  feedbackReports      FeedbackReport[]      @relation("FeedbackSubmittedBy")

  @@index([role])
  @@index([status])
}

model Semester {
  id        String   @id @default(cuid())
  label     String   @unique // "Fall 2026"
  startDate DateTime
  endDate   DateTime

  duesRecords   DuesRecord[]
  ledgerEntries PointsLedger[]

  @@index([startDate, endDate])
}

// ─────────────────────────────────────────────────────────────────────────
// Committees
// ─────────────────────────────────────────────────────────────────────────

model Committee {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CommitteeMembership[]
  events      Event[]
  channel     Channel?

  @@index([name])
}

model CommitteeMembership {
  id          String        @id @default(cuid())
  committeeId String
  userId      String
  role        CommitteeRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([committeeId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Events, RSVPs, Attendance
// ─────────────────────────────────────────────────────────────────────────

model Event {
  id                  String        @id @default(cuid())
  title               String
  description         String?
  location            String?
  latitude            Float?
  longitude           Float?
  startTime           DateTime
  endTime             DateTime
  category            EventCategory
  status              EventStatus   @default(DRAFT)
  attendanceRequired  Boolean       @default(false)
  pointValue          Int           @default(0)
  checkInWindowStart  DateTime?
  checkInWindowEnd    DateTime?
  lateThresholdMinutes Int          @default(15)
  checkInTokenSecret  String        // rotating QR signing secret, not exposed directly to clients
  committeeId         String?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  committee   Committee?   @relation(fields: [committeeId], references: [id])
  createdBy   User         @relation("EventCreatedBy", fields: [createdById], references: [id])
  rsvps       Rsvp[]
  attendances Attendance[]
  ledgerEntries PointsLedger[]

  @@index([startTime])
  @@index([category])
  @@index([committeeId])
  // Every list endpoint filters status="PUBLISHED" first, then a startTime
  // range — this compound index serves that combined filter directly
  // instead of Postgres falling back to the single-column startTime index
  // and re-checking status per row.
  @@index([status, startTime])
}

model Rsvp {
  id          String     @id @default(cuid())
  eventId     String
  userId      String
  status      RsvpStatus
  respondedAt DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

model Attendance {
  id              String        @id @default(cuid())
  eventId         String
  userId          String
  checkInTime     DateTime      @default(now())
  method          CheckInMethod
  late            Boolean       @default(false)
  pointsAwarded   Int           // snapshot — independent of later Event.pointValue edits
  recordedById    String?       // set when an officer manually marks attendance
  overrideReason  String?
  createdAt       DateTime      @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User  @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Points (append-only ledger)
// ─────────────────────────────────────────────────────────────────────────

model PointsLedger {
  id           String     @id @default(cuid())
  userId       String
  eventId      String?
  semesterId   String
  amount       Int        // can be negative for PENALTY/adjustment
  type         LedgerType
  reason       String?
  awardedById  String?    // null for system-generated ATTENDANCE entries
  createdAt    DateTime   @default(now())

  user      User      @relation("LedgerOwner", fields: [userId], references: [id], onDelete: Cascade)
  event     Event?    @relation(fields: [eventId], references: [id])
  semester  Semester  @relation(fields: [semesterId], references: [id])
  awardedBy User?     @relation("LedgerAwardedBy", fields: [awardedById], references: [id])

  @@index([userId, semesterId])
  @@index([semesterId])
}

// ─────────────────────────────────────────────────────────────────────────
// Dues & Payments
// ─────────────────────────────────────────────────────────────────────────

model DuesRecord {
  id          String     @id @default(cuid())
  userId      String
  semesterId  String
  amountOwed  Decimal    @db.Decimal(10, 2)
  amountPaid  Decimal    @default(0) @db.Decimal(10, 2)
  status      DuesStatus @default(UNPAID)
  dueDate     DateTime?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester Semester  @relation(fields: [semesterId], references: [id])
  payments Payment[]

  @@unique([userId, semesterId])
  @@index([status])
  @@index([semesterId])
}

model Payment {
  id            String        @id @default(cuid())
  duesRecordId  String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  externalRef   String?       // Stripe payment intent id, etc.
  recordedById  String?       // null for webhook-originated payments
  paidAt        DateTime      @default(now())

  duesRecord DuesRecord @relation(fields: [duesRecordId], references: [id], onDelete: Cascade)
  recordedBy User?      @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([duesRecordId])
}

// ─────────────────────────────────────────────────────────────────────────
// Messaging
// ─────────────────────────────────────────────────────────────────────────

model Channel {
  id          String      @id @default(cuid())
  name        String
  type        ChannelType
  committeeId String?     @unique // set only for COMMITTEE-type channels
  createdAt   DateTime    @default(now())

  committee Committee?          @relation(fields: [committeeId], references: [id])
  members   ChannelMembership[]
  messages  Message[]

  @@index([type])
}

model ChannelMembership {
  id        String            @id @default(cuid())
  channelId String
  userId    String
  role      ChannelMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id              String    @id @default(cuid())
  channelId       String
  senderId        String
  content         String
  parentMessageId String?
  pinned          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  channel Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User      @relation(fields: [senderId], references: [id])
  parent  Message?  @relation("Thread", fields: [parentMessageId], references: [id])
  replies Message[] @relation("Thread")

  @@index([channelId, createdAt])
  @@index([channelId, deletedAt, createdAt])  // last-message-per-channel query: filters deletedAt=null then sorts createdAt desc
  @@index([parentMessageId])
}

// ─────────────────────────────────────────────────────────────────────────
// Audit trail
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // e.g. "EVENT_UPDATE", "ATTENDANCE_OVERRIDE", "ROLE_CHANGE"
  entityType String   // e.g. "Event", "Attendance", "DuesRecord"
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Permission system — "roles should simply be permission presets."
// One row per (role, permission) grant. Permission is a free-text string
// (not an enum) so a new permission can be introduced by the application
// layer without a migration — matches src/types/index.ts ALL_PERMISSIONS
// on the mobile side, which is the source of truth for valid values.
// SUPER_ADMIN intentionally has no rows here — it always bypasses (see
// mobile src/permissions/permissions.ts hasPermission()); this mirrors that
// in the schema by simply never being queried for that role.
// ─────────────────────────────────────────────────────────────────────────

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  // No separate @@index([role]) — the unique constraint below already
  // leads with `role`, so it serves role-only lookups too; a second index
  // on the same leading column would be pure write-overhead with no read
  // benefit.
  @@unique([role, permission])
}

// ─────────────────────────────────────────────────────────────────────────
// Module / feature toggles
// ─────────────────────────────────────────────────────────────────────────

model Module {
  key         ModuleKey @id
  label       String
  description String?
  enabled     Boolean   @default(true)
  comingSoon  Boolean   @default(false)
}

// ─────────────────────────────────────────────────────────────────────────
// Chapter Settings — singleton row (id is always "default")
//
// This whole schema assumes ONE chapter per deployed database/backend
// instance (matches "ChapterHub" being branded and seeded for a single
// chapter). Nothing here is multi-tenant: there's no Chapter model, and
// every table (User, Event, DuesRecord, ...) is implicitly scoped to
// "whichever chapter this database belongs to." Scaling to MANY chapters
// sharing one deployment would need a Chapter model and a chapterId
// foreign key + index added to every tenant-scoped table — a real
// architectural change, not a config tweak. If that's the actual target
// deployment model (one shared backend for many chapters), plan it as its
// own migration project rather than retrofitting incrementally.
//
// Application code must always upsert this row by id: "default" — never
// create() with a different id, or the "one row per chapter" assumption
// silently breaks (Prisma has no built-in "exactly one row" constraint).
// ─────────────────────────────────────────────────────────────────────────

model ChapterSettings {
  id                              String   @id @default("default")
  chapterName                     String
  chapterLetters                  String
  university                      String
  logoUrl                         String?
  currentSemesterLabel            String
  semesterStartDate               DateTime
  semesterEndDate                 DateTime
  defaultDuesAmount               Decimal  @db.Decimal(10, 2)
  defaultDuesPlan                 String   @default("FULL")
  attendanceLateThresholdMinutes  Int      @default(15)
  defaultEventPointValue          Int      @default(5)
  updatedAt                       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Documents & external links
// ─────────────────────────────────────────────────────────────────────────

model Document {
  id           String           @id @default(cuid())
  category     DocumentCategory
  name         String
  fileLabel    String           // placeholder filename — no real object storage yet, see docs/DEMO_MODE.md
  sizeLabel    String?
  uploadedById String
  uploadedAt   DateTime         @default(now())

  uploadedBy User @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([category])
}

model ExternalLink {
  id       String  @id @default(cuid())
  label    String
  url      String
  category String?
}

// ─────────────────────────────────────────────────────────────────────────
// Feedback & bug reports
// ─────────────────────────────────────────────────────────────────────────

model FeedbackReport {
  id             String         @id @default(cuid())
  type           FeedbackType
  message        String
  submittedById  String?
  appVersion     String
  platform       String
  status         FeedbackStatus @default(OPEN)
  createdAt      DateTime       @default(now())

  submittedBy User? @relation("FeedbackSubmittedBy", fields: [submittedById], references: [id])

  @@index([status])
  @@index([type])
}
