# deploy/.env — copy to deploy/.env and fill in. NEVER commit the real file.
#
#   cp deploy/.env.example deploy/.env

# ── Where the app lives ──────────────────────────────────────────────────
# Hostname only — no https://, no trailing slash. Caddy requests a
# certificate for exactly this name, and the API's CORS_ORIGIN is derived
# from it. Changing this + re-running update.sh is the entire "move to a
# real domain" migration.
APP_HOSTNAME=yourchapter.duckdns.org

# Let's Encrypt uses this only to email you before a cert would expire.
ACME_EMAIL=you@example.com

# ── Database ─────────────────────────────────────────────────────────────
# Generate the password with:  openssl rand -base64 24
# It is never exposed outside the Docker network, but it does end up in
# backups and in `docker compose config` output.
POSTGRES_USER=chappter
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=chappter

# ── Clerk (authentication) ───────────────────────────────────────────────
# Clerk Dashboard → API Keys. On a development instance these are the
# pk_test_ / sk_test_ pair; a production instance uses pk_live_ / sk_live_.
# The publishable key is compiled into the browser bundle (that is normal and
# safe). The secret key is server-side only.
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional. Only needed to handle Clerk's user.deleted webhook, which soft-
# deletes the matching User row. Leave blank and that endpoint returns 503.
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Stripe (optional — dues payments) ────────────────────────────────────
# Leave both blank to run without card payments; the backend logs a warning
# at boot and the Stripe webhook route lazily returns 503. Everything else
# works normally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── DuckDNS (free dynamic DNS) ───────────────────────────────────────────
# Just the label, not the full name: for yourchapter.duckdns.org, use
# "yourchapter". Token comes from duckdns.org after signing in.
# Used by deploy/duckdns-update.sh, not by Docker.
DUCKDNS_DOMAIN=yourchapter
DUCKDNS_TOKEN=

# ── Backups ──────────────────────────────────────────────────────────────
# Optional. Leave unset (or delete this line) and backup.sh defaults to
# $HOME/chappter-backups, which never needs sudo — it's the first thing
# update.sh runs, so a directory only root can create here would break
# every deploy, not just the first. Point it at /var/backups/chappter
# instead only if you've already run, once:
#   sudo mkdir -p /var/backups/chappter && sudo chown $USER:$USER /var/backups/chappter
BACKUP_DIR=

# ── Cloudflare Tunnel (only for the later upgrade) ───────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=
