{
  "expo": {
    "name": "ChapterHub",
    "slug": "chapterhub",
    "version": "1.0.0",
    "scheme": "chapterhub",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thetatau.chapterhub",
      "infoPlist": {
        "NSCameraUsageDescription": "ChapterHub uses the camera to scan event check-in QR codes.",
        "NSPhotoLibraryUsageDescription": "ChapterHub does not access your photo library.",
        "NSCalendarsUsageDescription": "ChapterHub can add chapter events directly to your calendar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2A4A"
      },
      "package": "com.thetatau.chapterhub",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ChapterHub uses the camera to scan event check-in QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1B2A4A"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "ChapterHub can add chapter events directly to your calendar."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    }
  }
}
